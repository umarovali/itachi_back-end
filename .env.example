NODE_ENV=development
PORT=3000

# PostgreSQL: либо DATABASE_URL (так дают хостинги), либо DB_HOST/DB_PORT/...
# DATABASE_URL=postgres://user:pass@host:5432/db
# DB_SSL=true — для внешнего подключения к облачной БД
DB_HOST=localhost
DB_PORT=5432
DB_USER=totup
DB_PASSWORD=totup
DB_NAME=totup
# true — TypeORM автоматически синхронизирует схему (только для разработки!). В проде: false + миграции
DB_SYNC=true

# JWT (сгенерируйте длинные случайные строки)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
# lax | strict | none (none требует COOKIE_SECURE=true — если фронт на другом домене)
COOKIE_SAMESITE=lax

# Через запятую: адреса фронтенда (сайт + админка)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Куда сохранять файлы
UPLOAD_DIR=./uploads
# Базовая валюта: в ней хранятся цены товаров (создаётся автоматически)
BASE_CURRENCY=RUB
# Заголовок со страной клиента (Cloudflare: CF-IPCountry, nginx geoip: X-Country-Code)
GEO_COUNTRY_HEADER=CF-IPCountry

# Курсы валют: источник (по умолчанию ЦБ РФ) и как часто обновлять
RATES_SOURCE_URL=https://www.cbr-xml-daily.ru/daily_json.js
RATES_SYNC_INTERVAL_MIN=60

# Telegram-бот (создать у @BotFather). Пусто — бот выключен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# chat_id группы админов: добавьте бота в группу и напишите /chatid
TELEGRAM_ADMIN_CHAT_ID=
# Ссылки для кнопок в сообщениях (только https)
SITE_URL=https://example.com/orders/{id}
ADMIN_PANEL_URL=https://admin.example.com

# Swagger на /docs в production (для тестового сервера)
SWAGGER_ENABLED=false

# Через сколько минут неоплаченный заказ отменяется автоматически
ORDER_PAYMENT_TIMEOUT_MIN=60

# Первый суперадмин создаётся при старте, если его ещё нет
SUPERADMIN_PHONE=+998901234567
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Super Admin